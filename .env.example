# --- PATHS ---
PROJECT_ROOT=/path/to/meditronFO/
# scratch space for models, caches and prepared data (exported by most clusters)
SCRATCH=/path/to/scratch
STORAGE_ROOT=/path/to/base/model/weights
ENV=${PROJECT_ROOT}/container/new_axolotl.toml
USER_STORAGE=${SCRATCH}/
USER=<user>

# --- SECRETS ---
# Keep your existing values here (do not re-paste them publicly)
WANDB_API_KEY=<WANDB_API_KEY>
HF_TOKEN=<HF_TOKEN>
SLACK_WEBHOOK_URL=<SLACK_WEBHOOK_URL> #optional

# --- CONFIGS ---
WANDB_PROJECT=<WANDB_PROJECT>
WANDB_ENTITY=<WANDB_ENTITY>
# WandB run files
export WANDB_DIR="${SCRATCH}/wandb_logs"

# =============================================================================
# NODE-LOCAL CACHES (avoid NFS / shared filesystem)
# Prefer SLURM_TMPDIR (node-local), fallback to /tmp.
# Namespacing by job id avoids collisions when multiple jobs run on same node.
# =============================================================================
# NOTE: always use ${BRACED} form here. This file is read both by bash
# (`source .env`) and by python-dotenv (`load_dotenv()`), and python-dotenv
# only interpolates ${VAR} -- a bare $VAR is left as a literal string.
export CACHE_ROOT="${USER_STORAGE}/axolotl-cache/${SLURM_JOB_ID:-nojob}"

export HF_HOME="${CACHE_ROOT}/hf"


